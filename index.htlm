<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MTfy - Uganda's Vibe</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box;font-family:Arial,sans-serif}
  body{background:#0f0f0f;color:white;max-width:430px;margin:0 auto}
  .topbar{display:flex;justify-content:space-between;align-items:center;padding:12px 15px;background:#000;position:sticky;top:0;z-index:10}
  .logo{font-size:26px;font-weight:900} .logo span{color:#FF2D55}
  .lang{font-size:12px;background:#222;padding:6px 10px;border-radius:20px;border:1px solid #444}
  .cats{display:flex;gap:8px;padding:10px 15px;overflow-x:auto}
  .cat{padding:8px 16px;border-radius:20px;background:#222;white-space:nowrap;font-size:13px;cursor:pointer}
  .cat.active{background:#FF2D55}
  .video-card{margin:10px 15px;background:#1a1a1a;border-radius:16px;overflow:hidden;border:1px solid #2a2a2a}
  .thumb{height:280px;display:flex;align-items:flex-end;padding:15px;position:relative;background:linear-gradient(180deg,#333,#000)}
  .thumb.comedy{background:linear-gradient(180deg,#FF9500,#7a2e00)}
  .thumb.music{background:linear-gradient(180deg,#7B2FFF,#1a004d)}
  .thumb.ent{background:linear-gradient(180deg,#00C9A7,#003d33)}
  .play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:60px;opacity:.9}
  .live{position:absolute;top:12px;left:12px;background:red;padding:4px 8px;border-radius:6px;font-size:11px;font-weight:bold}
  .lowdata{position:absolute;top:12px;right:12px;background:#00C9A7;color:#000;padding:4px 8px;border-radius:6px;font-size:11px;font-weight:bold}
  .info{padding:12px}
  .creator{display:flex;align-items:center;gap:10px}
  .avatar{width:40px;height:40px;border-radius:50%;background:#FF2D55;display:flex;align-items:center;justify-content:center;font-weight:bold}
  .actions{display:flex;justify-content:space-between;margin-top:12px}
  .btn{flex:1;text-align:center;padding:10px;background:#222;border-radius:10px;margin:0 3px;font-size:13px}
  .btn.tip{background:#FFD60A;color:#000;font-weight:bold}
  .wallet{margin:15px;background:linear-gradient(90deg,#FF2D55,#FF9500);padding:15px;border-radius:16px}
  .wallet h3{font-size:14px} .wallet h1{font-size:28px;margin:5px 0}
  .bottom{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:430px;background:#000;display:flex;justify-content:space-around;padding:12px 0;border-top:1px solid #222}
  .nav{font-size:11px;text-align:center}
  .upload{width:50px;height:50px;background:#FF2D55;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:28px;margin-top:-25px;border:3px solid #000}
  select{width:100%;padding:10px;background:#222;color:white;border-radius:10px;border:none;margin-top:10px}
</style>
</head>
<body>

<div class="topbar">
  <div class="logo">MT<span>fy</span> 🇺🇬</div>
  <div class="lang">🌍 <span id="langLabel">English</span></div>
</div>

<div style="padding:0 15px">
  <label style="font-size:12px;color:#aaa">Choose Language / Londa / Chagua Lugha / Aijar Eong / Yero Leb:</label>
  <select id="langSelect" onchange="changeLang(this.value)">
    <option value="en">English</option>
    <option value="lg">Luganda</option>
    <option value="sw">Kiswahili</option>
    <option value="at">Ateso</option>
    <option value="ac">Acholi</option>
  </select>
</div>

<div class="cats">
  <div class="cat active" id="c1">😂 Comedy</div>
  <div class="cat" id="c2">🎵 Music</div>
  <div class="cat" id="c3">🎭 Entertainment</div>
  <div class="cat">🔥 Trending</div>
  <div class="cat">📍 Entebbe</div>
  <div class="cat">📍 Soroti</div>
  <div class="cat">📍 Gulu</div>
</div>

<div class="wallet">
  <h3 id="walletTitle">💰 Creator Wallet - MTN MoMo</h3>
  <h1>UGX 12,500</h1>
  <p style="font-size:12px" id="walletSub">1,250 views = 12,500 UGX • Withdraw Now →</p>
  <button style="margin-top:10px;width:100%;padding:10px;border:none;border-radius:10px;background:#000;color:white;font-weight:bold" onclick="alert('MoMo Withdraw: 12,500 UGX sent to 0770-XXX-XXX')">WITHDRAW VIA MOMO</button>
</div>

<!-- VIDEO 1 -->
<div class="video-card">
  <div class="thumb comedy"><span class="live">● LIVE</span><span class="lowdata">LOW DATA ✓</span><span class="play">▶️</span><div><h3>Teacher Mpamire Style - Entebbe Market 😂</h3><p style="font-size:12px;color:#ddd">Luganda • 45 sec • 12.4K views</p></div></div>
  <div class="info">
    <div class="creator"><div class="avatar">KB</div><div><b>Kabuye Benjamin</b><br><span style="font-size:12px;color:#aaa">@kabuye_comedy • Entebbe</span></div><button style="margin-left:auto;background:#FF2D55;border:none;color:white;padding:6px 12px;border-radius:20px">Follow</button></div>
    <p style="margin-top:10px;font-size:14px">When your mother finds you on TikTok instead of studying... 😂😂 #MTfyComedy</p>
    <div class="actions"><div class="btn">❤️ 2.1K</div><div class="btn">💬 340</div><div class="btn">↗️ Share</div><div class="btn tip" onclick="alert('You tipped 500 UGX to Kabuye via MTN MoMo!')">💰 Tip 500</div></div>
  </div>
</div>

<!-- VIDEO 2 -->
<div class="video-card">
  <div class="thumb music"><span class="lowdata">LOW DATA ✓</span><span class="play">▶️</span><div><h3>New Ateso Song - Soroti Boys 🎵</h3><p style="font-size:12px;color:#ddd">Ateso • 1:02 min • 8.9K views</p></div></div>
  <div class="info">
    <div class="creator"><div class="avatar" style="background:#7B2FFF">EO</div><div><b>Emuron Otim</b><br><span style="font-size:12px;color:#aaa">@otim_music • Soroti, Teso</span></div><button style="margin-left:auto;background:#FF2D55;border:none;color:white;padding:6px 12px;border-radius:20px">Follow</button></div>
    <p style="margin-top:10px;font-size:14px">New hit from Teso! Eong lo aijar? 🎵🔥 #AtesoMusic #MTfy</p>
    <div class="actions"><div class="btn">❤️ 1.8K</div><div class="btn">💬 210</div><div class="btn">↗️ Share</div><div class="btn tip" onclick="alert('You tipped 1,000 UGX to Otim via Airtel Money!')">💰 Tip 1K</div></div>
  </div>
</div>

<!-- VIDEO 3 -->
<div class="video-card">
  <div class="thumb ent"><span class="lowdata">LOW DATA ✓</span><span class="play">▶️</span><div><h3>Acholi Dance Challenge - Gulu 💃</h3><p style="font-size:12px;color:#ddd">Acholi • 38 sec • 25K views</p></div></div>
  <div class="info">
    <div class="creator"><div class="avatar" style="background:#00C9A7">AA</div><div><b>Akello Achieng</b><br><span style="font-size:12px;color:#aaa">@akello_dance • Gulu</span></div><button style="margin-left:auto;background:#FF2D55;border:none;color:white;padding:6px 12px;border-radius:20px">Follow</button></div>
    <p style="margin-top:10px;font-size:14px">Larakaraka dance! Who can do this? Tag your friend! 💃 #Acholi #MTfy</p>
    <div class="actions"><div class="btn">❤️ 5.2K</div><div class="btn">💬 890</div><div class="btn">↗️ Share</div><div class="btn tip" onclick="alert('You tipped 500 UGX to Akello via MTN MoMo!')">💰 Tip 500</div></div>
  </div>
</div>

<div style="padding:15px;text-align:center;color:#888;font-size:12px;padding-bottom:90px">
  MTfy © 2026 • Made in Uganda, For Uganda 🇺🇬<br>
  Comedy • Music • Entertainment • Luganda • Ateso • Acholi • Kiswahili • English<br>
  <b>1,000 views = 10,000 UGX for Creators via MoMo</b>
</div>

<div class="bottom">
  <div class="nav">🏠<br>Home</div>
  <div class="nav">🔍<br>Search</div>
  <div class="upload">+</div>
  <div class="nav">💰<br>Wallet</div>
  <div class="nav">👤<br>Profile</div>
</div>

<script>
function changeLang(v){
  const labels = {
    en: {lang:"English", wallet:"💰 Creator Wallet - MTN MoMo", sub:"1,250 views = 12,500 UGX • Withdraw Now →"},
    lg: {lang:"Luganda", wallet:"💰 Waleti yo - MTN MoMo", sub:"Abantu 1,250 balabye = UGX 12,500 • Ggyawo Kati →"},
    sw: {lang:"Kiswahili", wallet:"💰 Mkoba wa Muundaji - MTN MoMo", sub:"Mara 1,250 zimeonekana = UGX 12,500 • Toa Sasa →"},
    at: {lang:"Ateso", wallet:"💰 Ekisete Eong - MTN MoMo", sub:"Eong 1,250 eanyete = UGX 12,500 • Lemu Naka →"},
    ac: {lang:"Acholi", wallet:"💰 Kabedo pa Min Acwec - MTN MoMo", sub:"1,250 dano oneno = UGX 12,500 • Kwany Kombedi →"}
  };
  document.getElementById('langLabel').innerText = labels[v].lang;
  document.getElementById('walletTitle').innerText = labels[v].wallet;
  document.getElementById('walletSub').innerText = labels[v].sub;
  alert('Language changed to: ' + labels[v].lang + ' - MTfy is now in your language!');
}
</script>
</body>
</html>
